# Cloudflare R2 Yapılandırması
VITE_R2_ACCOUNT_ID=f53cff4b45603bf96d8fa8384e36ad6f
VITE_R2_ENDPOINT=https://f53cff4b45603bf96d8fa8384e36ad6f.r2.cloudflarestorage.com

# Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token ile alacağınız bilgiler:
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=

# R2 üzerinde oluşturduğunuz Bucket adı (Örnek: makinam-storage)
VITE_R2_BUCKET_NAME=

# R2 Bucket Settings > Public Access veya Custom Domain adresi (Örnek: https://pub-xxxxxx.r2.dev veya https://cdn.makinam.com)
VITE_R2_PUBLIC_URL=
